# Postgres: local, Docker (docker compose up -d), Neon or Supabase.
DATABASE_URL="postgresql://agrios:agrios@localhost:5432/agrios"
# The test suite uses a separate database (docker compose creates it).
TEST_DATABASE_URL="postgresql://agrios:agrios@localhost:5432/agrios_test"

# 64 hex characters (32 bytes). Signs invoices and audit checkpoints, and derives the simulators' shared secrets.
# npm run setup fills this in for you. Generate by hand: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SEED=""

# Public address of this app: used in QR codes, provider callbacks and SMS text.
APP_URL="http://localhost:3000"

# How Agri-OS reaches the simulated providers: http (default, like a real integration) or loopback (in-process).
PROVIDER_TRANSPORT="http"

# Simulated Zamtel Money credentials (any value; both sides read the same setting).
ZAMTEL_API_KEY="sim_test_key"

# Optional: real SMS through Africa's Talking (only the live world sends; seeded demo people never receive one).
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""

# Optional: protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""
